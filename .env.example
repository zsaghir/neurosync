# Copy this file to .env.local. Never commit the copied file.

# Values used by the Expo app. EXPO_PUBLIC_* values are visible to the client.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
# Server-only Clerk credential. Do not add an EXPO_PUBLIC_ prefix.
CLERK_SECRET_KEY=

# Server-only Gemini credential. Never give this an EXPO_PUBLIC_ prefix.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Browser origins allowed to call the Go API, separated by commas.
ALLOWED_ORIGINS=http://localhost:8081

# Local Docker ports.
API_PORT=8080
EXPO_PORT=8081
POSTGRES_PORT=5432

# Local Docker database. These defaults are for development only.
POSTGRES_DB=neurosync
POSTGRES_USER=neurosync
POSTGRES_PASSWORD=neurosync

# Optional PostgreSQL connection-pool tuning for the Go API.
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_STARTUP_TIMEOUT=10s
DB_READINESS_TIMEOUT=2s
